{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PAPER04_N2_REFERENCE_V4_1_SOURCE_RESULT_1_0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "implementation_id", "audit_id", "archive", "category", "positive_evidence", "decision_blocking_unresolved_reasons", "nondecisive_warnings", "negative_decision_completeness"],
  "properties": {
    "schema": {"const": "PAPER04_N2_REFERENCE_V4_1_SOURCE_RESULT_1_0"},
    "implementation_id": {"type": "string", "minLength": 1},
    "audit_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "archive": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "bytes", "validity"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0},
        "validity": {"enum": ["VALID", "UNRESOLVED", "INVALID"]}
      }
    },
    "category": {"enum": ["SOURCE_SUPPORTED_TEST_PRESENCE", "NO_SUPPORTED_TEST_SOURCE_IDENTIFIED", "SOURCE_EVIDENCE_UNRESOLVED"]},
    "positive_evidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "supporting_rules"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "supporting_rules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "decision_blocking_unresolved_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "nondecisive_warnings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "negative_decision_completeness": {
      "type": "object", "additionalProperties": false,
      "required": ["archive_identity", "path_boundary", "supported_sources_decoded", "no_positive", "no_suspicious_test_intent", "no_decisive_nonregular", "no_decisive_collision", "no_generated_marker", "no_unsupported_test_intent"],
      "properties": {
        "archive_identity": {"type": "boolean"}, "path_boundary": {"type": "boolean"}, "supported_sources_decoded": {"type": "boolean"},
        "no_positive": {"type": "boolean"}, "no_suspicious_test_intent": {"type": "boolean"}, "no_decisive_nonregular": {"type": "boolean"},
        "no_decisive_collision": {"type": "boolean"}, "no_generated_marker": {"type": "boolean"}, "no_unsupported_test_intent": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"category": {"const": "SOURCE_SUPPORTED_TEST_PRESENCE"}}}, "then": {"properties": {"positive_evidence": {"minItems": 1}, "decision_blocking_unresolved_reasons": {"maxItems": 0}}}},
    {"if": {"properties": {"category": {"const": "NO_SUPPORTED_TEST_SOURCE_IDENTIFIED"}}}, "then": {"properties": {"positive_evidence": {"maxItems": 0}, "decision_blocking_unresolved_reasons": {"maxItems": 0}, "nondecisive_warnings": {"maxItems": 0}}}},
    {"if": {"properties": {"category": {"const": "SOURCE_EVIDENCE_UNRESOLVED"}}}, "then": {"properties": {"positive_evidence": {"maxItems": 0}, "decision_blocking_unresolved_reasons": {"minItems": 1}}}}
  ]
}
